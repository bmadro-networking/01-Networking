Config for Area Border Router 1 between OSPF Area 0 and Area 1 (ABR1)

hostname ABR1
!
!
!
ip cef
no ipv6 cef
!
!
!
!
license udi pid CISCO2911/K9 sn FTX1524RYKD-
!
no ip domain-lookup
!
!
spanning-tree mode pvst
!
!
interface GigabitEthernet0/0
 no ip address
 duplex auto
 speed auto
!
interface GigabitEthernet0/1
 description AREA 0
 ip address 10.0.140.2 255.255.255.252
 duplex auto
 speed auto
!
interface GigabitEthernet0/2
 description AREA 1
 ip address 10.0.141.2 255.255.255.252
 duplex auto
 speed auto
!
interface Vlan1
 no ip address
 shutdown
!
router ospf 1
 log-adjacency-changes
 network 10.0.140.0 0.0.0.3 area 0
 network 10.0.141.0 0.0.0.3 area 1
!
ip classless
!
ip flow-export version 9
!
!
