Config for Router 1 OSPF Area 1 (OSPF_A1.1)

hostname OSPF_A1.1
!
ip cef
no ipv6 cef
!
!
!
!
license udi pid CISCO2911/K9 sn FTX1524V873-
!
!
no ip domain-lookup
!
!
spanning-tree mode pvst
!
interface GigabitEthernet0/0
 ip address 10.0.141.1 255.255.255.252
 duplex auto
 speed auto
!
interface GigabitEthernet0/1
 ip address 10.0.3.2 255.255.255.252
 duplex auto
 speed auto
!
interface GigabitEthernet0/2
 ip address 10.0.4.1 255.255.255.252
 duplex auto
 speed auto
!
interface Vlan1
 no ip address
 shutdown
!
router ospf 1
 log-adjacency-changes
 network 10.0.3.0 0.0.0.3 area 1
 network 10.0.4.0 0.0.0.3 area 1
 network 10.0.141.0 0.0.0.3 area 1
!
ip classless
