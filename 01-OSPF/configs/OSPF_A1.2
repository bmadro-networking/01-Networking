Config for Router 2 OSPF Area 1 (OSPF_A1.2)

hostname OSPF_A1.2
!
ip cef
no ipv6 cef
!
!
!
!
license udi pid CISCO2911/K9 sn FTX1524X783-
!
no ip domain-lookup
!
!
spanning-tree mode pvst
!
interface GigabitEthernet0/0
 ip address 10.10.35.1 255.255.255.252
 duplex auto
 speed auto
 shutdown
!
interface GigabitEthernet0/1
 ip address 10.0.3.1 255.255.255.252
 duplex auto
 speed auto
!
interface GigabitEthernet0/2
 ip address 10.0.5.2 255.255.255.252
 duplex auto
 speed auto
!
interface Vlan1
 no ip address
 shutdown
!
router ospf 1
 log-adjacency-changes
 redistribute bgp 501 subnets 
 network 10.0.3.0 0.0.0.3 area 1
 network 10.0.5.0 0.0.0.3 area 1
!
router bgp 501
 bgp log-neighbor-changes
 no synchronization
 neighbor 10.10.35.2 remote-as 500
 network 10.10.30.0 mask 255.255.255.0
 redistribute ospf 1 
!
ip classless
